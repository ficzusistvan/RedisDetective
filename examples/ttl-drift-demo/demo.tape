# VHS tape for the TTL-drift demo.
# Requires: vhs, a built CLI (pnpm build), and Redis (the tape starts compose).
#   vhs examples/ttl-drift-demo/demo.tape
Output examples/ttl-drift-demo/demo.gif
Set Shell bash
Set FontSize 14
Set Width 1200
Set Height 700
Set PlaybackSpeed 0.75
Type "./examples/ttl-drift-demo/run-demo.sh"
Enter
Sleep 12s
